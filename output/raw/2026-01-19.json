        "pull_request": {
          "url": "https://api.github.com/repos/nodejs/node/pulls/61167",
          "html_url": "https://github.com/nodejs/node/pull/61167",
          "diff_url": "https://github.com/nodejs/node/pull/61167.diff",
          "patch_url": "https://github.com/nodejs/node/pull/61167.patch",
